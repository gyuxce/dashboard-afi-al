# Copy this file to `.env.local` and fill in real values, then restart `npm run dev`.
# Without VITE_SHEETS_API_KEY the app runs in CSV-only mode (upload via File Center).

# Google Sheets API key (ambil dari Vercel > Settings > Environment Variables)
VITE_SHEETS_API_KEY=

# Spreadsheet utama (Mei/Jun/Jul 2026 dst)
VITE_SPREADSHEET_ID=

# Opsional: spreadsheet terpisah untuk periode Agu-Okt 2026
# VITE_SPREADSHEET_ID_AUG_OCT_2026=

# Opsional: roster Pilot CSAT (tab: Batch | CS ID | Tanggal Mulai | Tanggal Selesai | Catatan Coaching | Baseline)
#   kolom Baseline opsional — isi % manual (mis. 62 / 62% / 0.62); kosong = hitung otomatis 2 minggu
# Default: pakai VITE_SPREADSHEET_ID_AUG_OCT_2026 + tab "PILOT"
# VITE_SPREADSHEET_ID_PILOT=
# VITE_SHEET_PILOT=PILOT

# Opsional: override nama tab kalau beda dari default
# VITE_SHEET_CSID=CSID
# VITE_SHEET_PRODUCTIVITY=Productivity CSAT WHU
# VITE_SHEET_CSAT_SC=CSAT SC
# VITE_SHEET_SLA=SLA
# VITE_SHEET_SCHEDULE=Schedule
# VITE_SHEET_QA=QA
